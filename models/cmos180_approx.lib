* ---------------------------------------------------------------------------
* cmos180_approx.lib
*
* APPROXIMATE generic 180 nm-class CMOS models for ngspice (BSIM3v3, level 8)
* plus a vertical PNP (Gummel-Poon) and resistor temperature coefficients.
*
* These parameters were written by hand for this project. They are loosely
* shaped after public 180 nm-class textbook/PTM-style values and are NOT
* calibrated to any foundry process. Use the numbers produced with them as
* indicative of circuit behaviour, not of silicon.
*
* Corners are emulated by the Python driver through instance-level
* delvto / mulu0 shifts (see analogic/models.py), so a single card per device
* type is defined here.
* ---------------------------------------------------------------------------

.model nch nmos level=8 version=3.3
+ tnom=27 tox=4.1e-9 xj=1.0e-7 nch=2.3e17
+ vth0=0.42 k1=0.58 k2=-0.01 k3=0 k3b=0 w0=1e-7 nlx=1.7e-7
+ dvt0=1.5 dvt1=0.45 dvt2=-0.04 dvt0w=0 dvt1w=0 dvt2w=0
+ u0=320 ua=-1.0e-9 ub=2.3e-18 uc=5e-11 vsat=1.05e5
+ a0=1.8 ags=0.4 b0=0 b1=0 keta=-0.01 a1=0 a2=1
+ rdsw=120 prwg=0.4 prwb=-0.1 wr=1 wint=5e-9 lint=1.0e-8
+ voff=-0.09 nfactor=1.3 cit=0 cdsc=2.4e-4 cdscd=0 cdscb=0
+ eta0=0.003 etab=-0.04 dsub=0.5
+ pclm=1.2 pdiblc1=0.3 pdiblc2=4e-3 pdiblcb=-0.1 drout=0.6
+ pscbe1=6e8 pscbe2=1e-4 pvag=0.0 delta=0.01
+ kt1=-0.22 kt2=0.022 ute=-1.5 ua1=4.3e-9 ub1=-7.6e-18 uc1=-5.6e-11 at=3.3e4 prt=0
+ cgso=3.6e-10 cgdo=3.6e-10 cgbo=1e-12
+ cj=9.6e-4 pb=0.8 mj=0.38 cjsw=2.5e-10 pbsw=0.8 mjsw=0.33
+ js=1e-6 jsw=1e-12
+ af=1 kf=2.5e-26 noimod=1

.model pch pmos level=8 version=3.3
+ tnom=27 tox=4.1e-9 xj=1.0e-7 nch=4.1e17
+ vth0=-0.43 k1=0.55 k2=0.01 k3=0 k3b=0 w0=1e-7 nlx=1.2e-7
+ dvt0=0.6 dvt1=0.3 dvt2=0.1 dvt0w=0 dvt1w=0 dvt2w=0
+ u0=95 ua=1.2e-9 ub=1.0e-21 uc=-1e-10 vsat=1.0e5
+ a0=1.5 ags=0.35 b0=0 b1=0 keta=0.02 a1=0 a2=1
+ rdsw=320 prwg=0.4 prwb=0 wr=1 wint=5e-9 lint=1.0e-8
+ voff=-0.1 nfactor=1.6 cit=0 cdsc=2.4e-4 cdscd=0 cdscb=0
+ eta0=0.003 etab=-0.04 dsub=0.6
+ pclm=1.6 pdiblc1=0.02 pdiblc2=-1e-5 pdiblcb=-0.05 drout=0.5
+ pscbe1=6e8 pscbe2=1e-5 pvag=0.0 delta=0.01
+ kt1=-0.24 kt2=0.022 ute=-1.2 ua1=4.3e-9 ub1=-7.6e-18 uc1=-5.6e-11 at=3.3e4 prt=0
+ cgso=3.1e-10 cgdo=3.1e-10 cgbo=1e-12
+ cj=1.1e-3 pb=0.8 mj=0.41 cjsw=2.3e-10 pbsw=0.8 mjsw=0.33
+ js=1e-6 jsw=1e-12
+ af=1 kf=1.0e-27 noimod=1

* Vertical substrate PNP (unit emitter, approx. 2um x 2um)
.model vpnp pnp is=1.0e-17 bf=6 nf=1.0 br=0.1 vaf=60
+ ikf=1e-3 rb=200 re=5 rc=50 eg=1.17 xti=3.5
+ cje=4e-14 cjc=6e-14

* Poly resistor with first/second-order TC (approximate)
.model rpoly r tc1=-1.2e-3 tc2=1.0e-6
